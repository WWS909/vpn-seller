# ============================================================================
#  VPN Seller — настройки / settings
#  Скопируйте в .env и заполните. Copy to .env and fill in.
#  Всё, что меняется на ходу (тарифы, серверы, тексты), — в админ-панели.
#  Things you change while running (plans, servers, texts) live in the admin panel.
# ============================================================================

# --- Основное / Core -------------------------------------------------------

# Как магазин доступен снаружи (install.sh выбирает сам):
#   caddy  — свой Caddy на портах 80/443 с сертификатом для DOMAIN
#   tunnel — временный адрес Cloudflare, домен не нужен (TUNNEL_METRICS_URL=http://tunnel:2000)
#   пусто  — через уже стоящий на сервере Caddy/nginx (docker-compose.override.yml)
# How the shop is reached: caddy | tunnel | empty (an existing proxy). install.sh picks it.
COMPOSE_PROFILES=caddy

# Домен сервиса. На него Caddy получит сертификат, по нему открывается приложение.
# The service domain: Caddy gets the certificate for it; the app opens at it.
DOMAIN=vpn.example.com
# PUBLIC_URL=https://vpn.example.com     # по умолчанию https://DOMAIN / defaults to https://DOMAIN

# Токен бота от @BotFather. Bot token from @BotFather.
BOT_TOKEN=

# Длинная случайная строка (32+ символа): openssl rand -hex 32
# A long random string (32+ chars): openssl rand -hex 32
SECRET_KEY=

# Вход в админ-панель https://DOMAIN/admin (пароль — от 8 символов).
# Admin panel login (password: 8+ characters).
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# Администраторы в Telegram (через запятую): получают сообщения об оплатах и сбоях,
# управляют магазином командами бота (/admin) и входят в панель из Telegram без пароля.
# Узнать свой ID: @userinfobot.  Admins: payment notes, bot commands, panel without password.
ADMIN_TELEGRAM_IDS=

# Валюта цен: RUB, USD, EUR, UAH, KZT...  Currency of prices.
CURRENCY=RUB
# Язык по умолчанию (ru/en), если язык Telegram неизвестен. Default language.
DEFAULT_LANG=ru

# --- Первый сервер 3x-ui (необязательно) / First 3x-ui server (optional) ----
# Можно не заполнять и добавить серверы в админ-панели → «Серверы».
# Optional: servers can be added in the admin panel instead.
# XUI_URL=https://panel.example.com:2053/secretpath/
# XUI_TOKEN=                  # 3x-ui 3.x: Настройки → Безопасность → API Token
# XUI_USERNAME=               # или логин и пароль / or login and password
# XUI_PASSWORD=
# XUI_INBOUNDS=1              # ID инбаундов через запятую / inbound IDs, comma-separated
# XUI_SUB_URL=                # только для 3x-ui 2.x: https://panel.example.com:2096/sub/
# XUI_EMAIL_PREFIX=tg         # клиенты на панели называются tg<telegram id>

# --- Оплата / Payments --------------------------------------------------------
# Telegram Stars работают сразу, ничего настраивать не нужно.
# Telegram Stars work out of the box.
STARS_ENABLED=true

# Крипта через @CryptoBot → Crypto Pay → Create App.  Crypto via @CryptoBot.
# Webhooks → https://DOMAIN/api/pay/cryptobot
CRYPTOBOT_TOKEN=
CRYPTOBOT_TESTNET=false

# Карты и СБП — одна касса или несколько через запятую (покупатель выберет):
#   yookassa | freekassa | platega | paypalych | lava | wata | tribute | cloudpayments | mulenpay | rollypay | cispay
# Проще настроить в админке: Система → Оплата.
# Cards / bank payments — one gateway or several, comma-separated. Empty = no card payments.
CARD_GATEWAY=

# ЮKassa (нужны ИП или самозанятость). Уведомления: https://DOMAIN/api/pay/yookassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# FreeKassa. URL оповещения: https://DOMAIN/api/pay/freekassa
FREEKASSA_MERCHANT_ID=
FREEKASSA_SECRET1=
FREEKASSA_SECRET2=
# Необязательно: ключ API из кабинета FreeKassa — магазин сам спросит статус
# оплаты, если уведомление от кассы не дошло.
FREEKASSA_API_KEY=

# Platega. Callback: https://DOMAIN/api/pay/platega
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=
# PLATEGA_METHOD=             # пусто — страница кассы сама предложит способы

# PayPalych (pally.info). Result URL: https://DOMAIN/api/pay/paypalych
PAYPALYCH_TOKEN=
PAYPALYCH_SHOP_ID=
# PAYPALYCH_API_BASE=https://paypalych.com/api/v1

# Lava (lava.ru, только рубли). Hook URL: https://DOMAIN/api/pay/lava
LAVA_SHOP_ID=
LAVA_SECRET_KEY=
LAVA_ADDITIONAL_KEY=

# WATA. Webhook: https://DOMAIN/api/pay/wata
WATA_TOKEN=
# WATA_API_BASE=https://api.wata.pro/api/h2h

# Tribute (tribute.tg → Магазин → API). Вебхук: https://DOMAIN/api/pay/tribute
TRIBUTE_API_KEY=
# TRIBUTE_SHOP_ID=           # пусто — первый магазин аккаунта

# CloudPayments. Уведомление Pay: https://DOMAIN/api/pay/cloudpayments
CLOUDPAYMENTS_PUBLIC_ID=
CLOUDPAYMENTS_API_SECRET=

# MulenPay. Callback: https://DOMAIN/api/pay/mulenpay
MULENPAY_API_KEY=
MULENPAY_SECRET_KEY=
MULENPAY_SHOP_ID=
# MULENPAY_API_BASE=https://mulenpay.ru/api

# RollyPay: API-ключ и signing secret кассы. Callback URL кассы: https://DOMAIN/api/pay/rollypay
ROLLYPAY_API_KEY=
ROLLYPAY_SIGNING_SECRET=

# cisPay: ID магазина и секретный ключ (cis_sec_…). Вебхук: https://DOMAIN/api/pay/cispay
CISPAY_SHOP_ID=
CISPAY_API_KEY=

# Lave Pay (Лавешка): счета в долларах по вашему курсу. Вебхук: https://DOMAIN/api/pay/lavepay
LAVEPAY_API_KEY=
LAVEPAY_WEBHOOK_SECRET=
LAVEPAY_RUB_PER_USD=

# Крипта: cryptobot | heleket | lavepay (пусто — первая, у которой есть ключи).
# Heleket. Callback: https://DOMAIN/api/pay/heleket
CRYPTO_GATEWAY=
HELEKET_MERCHANT_ID=
HELEKET_API_KEY=

# Чеки «Мой налог» для самозанятых: ИНН и пароль от lknpd.nalog.ru.
# Чек создаётся сам после каждой оплаты через кассы из NALOG_GATEWAYS
# (по умолчанию freekassa,platega,paypalych,lava,wata — ЮKassa шлёт чеки сама).
NALOG_INN=
NALOG_PASSWORD=
# NALOG_GATEWAYS=freekassa,platega,paypalych,lava,wata

# Только для разработки: все заказы бесплатны. Never enable in production.
PAYMENTS_TEST_MODE=false

# --- Прочее / Misc -------------------------------------------------------------
# База по умолчанию — SQLite в ./data. PostgreSQL:
# DATABASE_URL=postgresql+psycopg://vpn:password@db:5432/vpn
# Сервис сам регистрирует вебхук, кнопку меню и /start у бота. Выключите,
# если этот бот обслуживается чем-то ещё.  Auto-setup of the bot webhook and menu.
BOT_SETUP=true
# Только для временного адреса: откуда магазин узнаёт текущий адрес туннеля.
# Tunnel mode only: where the shop reads the current tunnel address.
# TUNNEL_METRICS_URL=http://tunnel:2000

# Платная проверка серверов из регионов России (dpichecker.st), ключ из их кабинета.
# Бесплатная своя проверка настраивается в панели: «Авария» → «Доступность из России».
# DPICHECKER_API_KEY=

# --- Обновления / Updates ------------------------------------------------------
# Откуда магазин узнаёт о новых версиях и берёт их (по умолчанию — репозиторий,
# вписанный в install.sh). Where new versions come from (default: the repo in install.sh).
# UPDATE_REPO=ivan/vpn-seller
# UPDATE_BRANCH=main
# Только для закрытого репозитория: токен GitHub с правом чтения (Contents: read).
# Private repository only: a GitHub token that can read it.
# GITHUB_TOKEN=
